def collect_setuid_files():
    """
    Returns:
      (files, error)

    files: list[str] or None
    error: str or None
    """

    rc, out, err = run_cmd([
        "timeout",
        "5",
        "find",
        "/",
        "-xdev",
        "-perm",
        "-4000",
        "-type",
        "f",
    ])

    if rc == 124:
        return (
            None,
            "find timed out",
        )

    if rc != 0:
        return (
            None,
            (
                "find error: "
                f"{err.strip()[:160]}"
            ),
        )

    files = sorted(
        set(
            ln.strip()
            for ln
            in out.splitlines()
            if ln.strip()
        )
    )

    return (
        files,
        None,
    )


def check_setuid(st: dict) -> None:

    current, err = (
        collect_setuid_files()
    )

    if err is not None:
        local_line(
            3,
            "SEC_SETUID",
            (
                "Cannot collect setuid files: "
                f"{err}"
            ),
        )
        return

    prev = st.get(
        "setuid_files"
    )

    if prev is None:

        st[
            "setuid_files"
        ] = current

        local_line(
            1,
            "SEC_SETUID",
            (
                "Baseline created "
                "(setuid list)"
            ),
        )

        return

    new = sorted(
        set(current)
        - set(prev)
    )

    st[
        "setuid_files"
    ] = current

    if new:
        local_line(
            2,
            "SEC_SETUID",
            (
                "New setuid binaries: "
                + ", ".join(
                    new[:6]
                )
            ),
        )

    else:
        local_line(
            0,
            "SEC_SETUID",
            "OK",
        )


