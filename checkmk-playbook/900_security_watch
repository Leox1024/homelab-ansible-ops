def collect_authorized_keys() -> dict:

    paths = [
        AUTH_KEY_PATHS[0]
    ]

    base = (
        AUTH_KEY_PATHS[1]
    )

    try:
        if (
            base.exists()
            and base.is_dir()
        ):
            paths.extend(
                list(
                    base.glob(
                        "*/.ssh/authorized_keys"
                    )
                )
            )

    except Exception:
        pass

    out = {}

    for p in paths:

        if p.exists():

            try:
                out[str(p)] = (
                    sha256_file(p)
                )

            except Exception:
                out[str(p)] = (
                    "unreadable"
                )

    return out


def check_ssh_keys(
    st: dict,
) -> None:

    current = (
        collect_authorized_keys()
    )

    prev = st.get(
        "ssh_authorized_keys"
    )

    if prev is None:

        st[
            "ssh_authorized_keys"
        ] = current

        local_line(
            1,
            "SEC_SSH_KEYS",
            (
                "Baseline created "
                "(authorized_keys)"
            ),
        )

        return

    changed = sorted([
        k
        for k in current
        if prev.get(k)
        != current[k]
    ])

    removed = sorted([
        k
        for k in prev
        if k not in current
    ])

    st[
        "ssh_authorized_keys"
    ] = current

    if changed or removed:

        parts = []

        if changed:
            parts.append(
                f"changed={len(changed)}"
            )

        if removed:
            parts.append(
                f"removed={len(removed)}"
            )

        examples = (
            changed
            + removed
        )[:6]

        local_line(
            2,
            "SEC_SSH_KEYS",
            (
                "authorized_keys delta "
                f"({', '.join(parts)}): "
                f"{', '.join(examples)}"
            ),
        )

    else:
        local_line(
            0,
            "SEC_SSH_KEYS",
            "OK",
        )


