def check_suspicious_processes():

    rc, out, err = run_cmd([
        "ps",
        "-eo",
        "pid=,user=,pcpu=,pmem=,args=",
    ])

    if rc != 0:
        return (
            None,
            None,
            f"ps error: {err.strip()[:200]}",
        )

    suspicious = []
    cgroup_cache = {}

    for line in out.splitlines():

        line = line.strip()

        if not line:
            continue

        parts = line.split(
            None,
            4,
        )

        if len(parts) < 5:
            continue

        pid, user, pcpu, pmem, args = (
            parts
        )

        if ALLOW_PROC_ARGS_RE.search(args):
            continue

        exe = proc_readlink(
            pid,
            "exe",
        )

        exe_is_temp = (
            any(
                exe.startswith(pref)
                for pref
                in TEMP_EXE_PREFIXES
            )
            if exe
            else False
        )

        matched_deleted = bool(
            DELETED_RE.search(args)
        )

        matched_name = bool(
            SUSP_NAME_RE.search(args)
        )

        matched_tmp_in_args = bool(
            SUSP_ARGS_PATH_RE.search(args)
        )

        is_container = (
            pid_is_containerized(
                pid,
                cgroup_cache,
            )
        )

        weak_only = (
            matched_tmp_in_args
            and not (
                matched_deleted
                or matched_name
                or exe_is_temp
            )
        )

        if is_container and weak_only:
            continue

        if (
            exe_is_temp
            or matched_deleted
            or matched_name
            or matched_tmp_in_args
        ):
            suspicious.append(
                (
                    pid,
                    user,
                    pcpu,
                    pmem,
                    (exe or "-")[:120],
                    args[:160],
                )
            )

    return (
        suspicious,
        len(suspicious),
        None,
    )


def check_proc(st: dict) -> None:

    susp_list, susp_count, err = (
        check_suspicious_processes()
    )

    if err is not None:
        local_line(
            3,
            "SEC_PROC",
            f"Cannot list processes: {err}",
        )
        return

    examples = "-"

    if susp_count:
        ex = []

        for (
            pid,
            user,
            _,
            _,
            exe,
            args,
        ) in susp_list[:3]:

            ex.append(
                (
                    f"{pid}:{user}:"
                    f"exe={exe}:"
                    f"args={args}"
                )
            )

        examples = "; ".join(ex)

    perf = (
        f"susp={susp_count};"
        f"{SUSP_PROC_WARN};"
        f"{SUSP_PROC_CRIT}"
    )

    if susp_count >= SUSP_PROC_CRIT:
        local_line(
            2,
            "SEC_PROC",
            (
                f"Suspicious processes: {susp_count} "
                f"(examples: {examples})"
            ),
            perf=perf,
        )

    elif susp_count >= SUSP_PROC_WARN:
        local_line(
            1,
            "SEC_PROC",
            (
                f"Suspicious processes: {susp_count} "
                f"(examples: {examples})"
            ),
            perf=perf,
        )

    else:
        local_line(
            0,
            "SEC_PROC",
            f"OK (suspicious={susp_count})",
            perf=perf,
        )


