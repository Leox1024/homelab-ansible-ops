def check_fstab(st: dict) -> None:

    def fstab_hash():

        if not FSTAB_PATH.exists():
            return "missing"

        return sha256_file(
            FSTAB_PATH
        )

    check_integrity(
        st,
        "fstab_sha256",
        "SEC_FSTAB",
        fstab_hash,
    )


# ======================================================================
# ----------------------------- SEC_CRON -----------------------------
# Cron changes:
# - CRIT immediately
# - keep CRIT while changed state is unstable
# - auto-accept after 5 minutes of unchanged state


def check_cron(st: dict) -> None:

    def cron_hash():
        digest, nfiles = (
            sha256_tree(
                CRON_PATHS
            )
        )

        return (
            f"{digest}:{nfiles}"
        )

    st.setdefault(
        "integrity",
        {},
    )

    st.setdefault(
        "pending_integrity",
        {},
    )

    key = "cron_tree"

    current = cron_hash()

    baseline = (
        st["integrity"].get(key)
    )

    pending = (
        st["pending_integrity"].get(
            key
        )
    )

    now = int(time.time())

    # First run
    if baseline is None:

        st["integrity"][key] = (
            current
        )

        st[
            "pending_integrity"
        ].pop(
            key,
            None,
        )

        local_line(
            1,
            "SEC_CRON",
            "Baseline created (first run).",
        )

        return

    # Current state matches baseline
    if baseline == current:

        st[
            "pending_integrity"
        ].pop(
            key,
            None,
        )

        local_line(
            0,
            "SEC_CRON",
            "OK",
        )

        return

    # New/different change:
    # restart stability timer
    if (
        pending is None
        or pending.get("hash")
        != current
    ):

        st[
            "pending_integrity"
        ][key] = {
            "hash": current,
            "since": now,
        }

        local_line(
            2,
            "SEC_CRON",
            (
                "Changed since baseline. "
                "Auto-accept in 5 minutes "
                "if unchanged."
            ),
        )

        return

    since = pending.get(
        "since",
        now,
    )

    elapsed = (
        now
        - int(since)
    )

    if elapsed < CRON_ALERT_TTL:

        remaining = (
            CRON_ALERT_TTL
            - elapsed
        )

        local_line(
            2,
            "SEC_CRON",
            (
                "Changed since baseline. "
                f"Auto-accept in {remaining}s "
                "if unchanged."
            ),
        )

        return

    # Changed state remained stable long enough
    st["integrity"][key] = (
        current
    )

    st[
        "pending_integrity"
    ].pop(
        key,
        None,
    )

    local_line(
        0,
        "SEC_CRON",
        (
            "OK - cron baseline "
            "auto-accepted after "
            f"{CRON_ALERT_TTL}s."
        ),
    )


