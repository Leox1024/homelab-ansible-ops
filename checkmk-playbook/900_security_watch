def parse_local_port_from_ss_line(
    ss_line,
):

    parts = ss_line.split()

    if len(parts) < 4:
        return None

    local = parts[3]

    try:

        if local.startswith("["):
            _, port = (
                local.rsplit(
                    "]:",
                    1,
                )
            )

            return int(port)

        if ":" in local:
            _, port = (
                local.rsplit(
                    ":",
                    1,
                )
            )

            return int(port)

    except Exception:
        return None

    return None


def collect_tcp_listeners():

    rc, out, err = run_cmd([
        "ss",
        "-lntpH",
    ])

    if rc != 0:
        return (
            None,
            (
                "ss error: "
                f"{err.strip()[:160]}"
            ),
        )

    listeners = []

    for line in out.splitlines():

        line = line.strip()

        if not line:
            continue

        if not line.startswith(
            "LISTEN"
        ):
            continue

        listeners.append(line)

    return (
        sorted(set(listeners)),
        None,
    )


def check_listen(
    st: dict,
) -> None:

    current, err = (
        collect_tcp_listeners()
    )

    if err is not None:
        local_line(
            3,
            "SEC_LISTEN",
            (
                "Cannot list TCP listeners: "
                f"{err}"
            ),
        )
        return

    prev = st.get(
        "tcp_listeners"
    )

    zero_port = False

    for line in current:

        port = (
            parse_local_port_from_ss_line(
                line
            )
        )

        if port == 0:
            zero_port = True
            break

    if prev is None:

        st[
            "tcp_listeners"
        ] = current

        local_line(
            1,
            "SEC_LISTEN",
            (
                "Baseline created "
                "(TCP listeners)"
            ),
        )

        return

    new = sorted(
        set(current)
        - set(prev)
    )

    st[
        "tcp_listeners"
    ] = current

    perf = (
        f"new={len(new)};;;"
    )

    if zero_port:
        local_line(
            2,
            "SEC_LISTEN",
            (
                "TCP listener on port 0 "
                "detected (abnormal)"
            ),
            perf=perf,
        )
        return

    if new:
        local_line(
            1,
            "SEC_LISTEN",
            (
                f"New TCP listeners: {len(new)} "
                f"(example: {new[0][:160]})"
            ),
            perf=perf,
        )

    else:
        local_line(
            0,
            "SEC_LISTEN",
            "OK",
            perf=perf,
        )


# ======================================================================
# ----------------------------- SEC_USERS -----------------------------


def parse_passwd_users() -> dict:

    users = {}

    if not PASSWD_PATH.exists():
        return users

    try:

        for line in (
            PASSWD_PATH
            .read_text(
                errors="ignore"
            )
            .splitlines()
        ):

            if (
                not line
                or line.startswith("#")
            ):
                continue

            parts = line.split(":")

            if len(parts) < 7:
                continue

            (
                name,
                _,
                uid,
                gid,
                _,
                home,
                shell,
            ) = parts[:7]

            try:
                uid_i = int(uid)
                gid_i = int(gid)

            except ValueError:
                continue

            users[name] = {
                "uid": uid_i,
                "gid": gid_i,
                "home": home,
                "shell": shell,
            }

    except Exception:
        return users

    return users


def check_new_users(
    st: dict,
) -> None:

    current = (
        parse_passwd_users()
    )

    prev = st.get(
        "passwd_users"
    )

    if prev is None:

        st[
            "passwd_users"
        ] = current

        local_line(
            1,
            "SEC_USERS",
            (
                "Baseline created "
                "(/etc/passwd snapshot)"
            ),
        )

        return

    new_names = sorted(
        set(current.keys())
        - set(prev.keys())
    )

    st[
        "passwd_users"
    ] = current

    new_human = [
        u
        for u in new_names
        if (
            current[u]["uid"]
            >= HUMAN_UID_MIN
            and u != "nobody"
        )
    ]

    new_system = [
        u
        for u in new_names
        if u not in new_human
    ]

    perf = (
        f"new_human={len(new_human)};;;"
        f"|new_system={len(new_system)};;;"
    )

    if new_human:
        local_line(
            2,
            "SEC_USERS",
            (
                f"New users "
                f"(uid>={HUMAN_UID_MIN}): "
                f"{', '.join(new_human[:8])}"
            ),
            perf=perf,
        )

    elif new_system:
        local_line(
            1,
            "SEC_USERS",
            (
                "New system users: "
                f"{', '.join(new_system[:8])}"
            ),
            perf=perf,
        )

    else:
        local_line(
            0,
            "SEC_USERS",
            "OK",
            perf=perf,
        )


